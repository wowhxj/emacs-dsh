    (emacs-dsh--event '((type . "tool/result") (seq . 3)))
    (should (string-match-p "thinking" (emacs-dsh--state)))
    (emacs-dsh--event '((type . "turn/end") (seq . 4)))
    (should (string-match-p "DSH idle" (emacs-dsh--state)))
    (should-not emacs-dsh--spinner-timer)))

(ert-deftest emacs-dsh-events-connection-and-result-wire ()
  (let ((emacs-dsh--cookie-jar "session=fake")
        (emacs-dsh--events-socket nil)
        (emacs-dsh--events-client nil)
        (emacs-dsh--events-retry nil)
        callbacks sent answer)
    (cl-letf (((symbol-function 'websocket-open)
               (lambda (_url &rest options) (setq callbacks options) 'events-test-socket))
              ((symbol-function 'websocket-send-text)
               (lambda (_socket text) (setq sent (json-parse-string text :object-type 'alist))))
              ((symbol-function 'emacs-dsh--base)
               (lambda () "http://127.0.0.1:3080/"))
              ((symbol-function 'emacs-dsh--call)
               (lambda (endpoint args success &optional _error)
                 (setq answer (list endpoint args))
                 (funcall success t)))
              ((symbol-function 'completing-read)
               (lambda (&rest _) "Alpha")))
      (emacs-dsh--events-connect)
      (should (equal (cdr (assoc "Cookie" (plist-get callbacks :custom-header-alist)))
                     "session=fake"))
      (funcall (plist-get callbacks :on-open) 'events-test-socket)
      (should (equal (alist-get 'endpoint sent) "$events"))
      (setq emacs-dsh--events-client "client")
      (emacs-dsh--events-answer
       '("client" "e1" "s1" "user-questions/request"
         ((questions . (((id . "q1") (question . "Select")
                         (options . (((label . "Alpha"))))))))))
      (should (equal (car answer) "$events/result"))
      (should (equal (alist-get 'clientId (cadr answer)) "client"))
      (should (equal (alist-get 'selected
                                (aref (alist-get 'answers
                                                (alist-get 'value
                                                           (alist-get 'outcome (cadr answer)))) 0))
                     ["Alpha"])))))

(ert-deftest emacs-dsh-cancelled-interaction-does-not-send-stale-result ()
  (let ((emacs-dsh--events-client "new-client")
        (emacs-dsh--events-cancelled '("cancelled")))
    (cl-letf (((symbol-function 'emacs-dsh--call)
               (lambda (&rest _) (ert-fail "stale interaction was sent"))))
      (emacs-dsh--events-result '("old-client" "e1" "s1")
                                '((kind . "next")))
      (emacs-dsh--events-result '("new-client" "cancelled" "s1")
                                '((kind . "result") (value . "allowed-once"))))))

(ert-deftest emacs-dsh-chat-buffer-uses-working-directory-name ()
  (let ((emacs-dsh--chats (make-hash-table :test #'equal))
        (root (make-temp-file "emacs-dsh-project-" t)))
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'emacs-dsh--follow) #'ignore)
                    ((symbol-function 'emacs-dsh--events-connect) #'ignore)
                    ((symbol-function 'emacs-dsh--refresh-model-selection) #'ignore))
            (emacs-dsh--show "session-opaque" root)
            (should (string-match-p (regexp-quote (file-name-nondirectory root))
                                    (buffer-name)))
            (should-not (string-match-p "session-opaque" (buffer-name)))
            (kill-buffer (current-buffer))))
      (delete-directory root))))

(ert-deftest emacs-dsh-resume-cross-workspace-replaces-current-chat ()
  (let ((emacs-dsh--chats (make-hash-table :test #'equal))
        (origin (generate-new-buffer " *dsh-replace-origin*"))
        (target (generate-new-buffer " *dsh-replace-target*"))
        (items '(((sessionId . "old") (cwd . "/tmp/workspace-one"))
                 ((sessionId . "other") (cwd . "/tmp/workspace-two"))))
        labels)
    (unwind-protect
        (save-window-excursion
          (with-current-buffer origin
            (emacs-dsh-chat-mode)
            (setq-local emacs-dsh--session-id "new" emacs-dsh--root "/tmp/new")
            (emacs-dsh--compose))
          (puthash "new" origin emacs-dsh--chats)
          (switch-to-buffer origin)
          (cl-letf (((symbol-function 'emacs-dsh--defer-picker)
                     (lambda (callback) (funcall callback)))
                    ((symbol-function 'completing-read)
                     (lambda (_prompt choices &rest _args)
                       (setq labels (mapcar #'car choices))
                       (caar (last choices))))
                    ((symbol-function 'emacs-dsh--show)
                     (lambda (_id _cwd) (switch-to-buffer target))))
            (emacs-dsh--resume-picker items))
          (should (cl-some (lambda (row) (string-match-p "workspace-one" row)) labels))
          (should (cl-some (lambda (row) (string-match-p "workspace-two" row)) labels))
          (should (= (string-width (substring (car labels) 0
                                            (string-match "(empty session)" (car labels))))
                     (string-width (substring (cadr labels) 0
                                            (string-match "(empty session)" (cadr labels))))))
          (should (eq (current-buffer) target))
          (should-not (buffer-live-p origin)))
      (when (buffer-live-p origin) (kill-buffer origin))
      (when (buffer-live-p target) (kill-buffer target)))))

