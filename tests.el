(ert-deftest emacs-dsh-orderless-external-path-and-smart-case ()
  (skip-unless (require 'orderless nil t))
  (let ((root (make-temp-file "dsh-completion-root-" t))
        (external (make-temp-file "dsh-completion-external-" t))
        (completion-styles '(orderless basic))
        (completion-ignore-case nil)
        (orderless-smart-case t))
    (unwind-protect
        (progn
          (make-directory (expand-file-name "SemIf" external))
          (make-directory (expand-file-name "Unrelated" external))
          (with-temp-buffer
            (emacs-dsh-chat-mode)
            (setq emacs-dsh--root root)
            (emacs-dsh--compose)
            (emacs-dsh--replace-draft "@")
            (cl-letf (((symbol-function 'emacs-dsh--defer-picker) (lambda (fn) (funcall fn)))
                      ((symbol-function 'completing-read)
                       (lambda (_prompt table &rest _)
                         (should completion-ignore-case)
                         (should-not orderless-smart-case)
                         (dolist (suffix '("s e m if" "SEM i"))
                           (let ((query (concat external "/" suffix)))
                             (cl-letf (((symbol-function 'minibufferp) (lambda (&rest _) t))
                                       ((symbol-function 'minibuffer-contents-no-properties)
                                        (lambda () query)))
                               ;; Orderless asks the table with an empty prefix.
                               (should (member (concat external "/SemIf/")
                                               (all-completions "" table)))
                               (let* ((matches (completion-all-completions query table nil (length query)))
                                      (tail (last matches)))
                                 (when tail (setcdr tail nil))
                                 (should (equal matches (list (concat external "/SemIf/"))))))))
                         (let ((directory (concat external "/SemIf/")))
                           (should (test-completion directory table))
                           directory))))
              (emacs-dsh--show-reference-choices
               (emacs-dsh--completion-context)
               '(((path . "first.el")) ((path . "second.el"))) nil))
            (should (equal (emacs-dsh--draft-text) (concat "@" external "/SemIf/")))))
      (delete-directory root t)
      (delete-directory external t))
    (should-not completion-ignore-case)
    (should orderless-smart-case)))

