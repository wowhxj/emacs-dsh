(ert-deftest emacs-dsh-resume-cancel-keeps-unsent-draft ()
  (let ((origin (generate-new-buffer " *dsh-unsent*")))
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer origin)
          (emacs-dsh-chat-mode)
          (setq-local emacs-dsh--session-id "new" emacs-dsh--root "/tmp")
          (emacs-dsh--compose)
          (emacs-dsh--replace-draft "unsent note")
          (cl-letf (((symbol-function 'emacs-dsh--defer-picker)
                     (lambda (callback) (funcall callback)))
                    ((symbol-function 'completing-read)
                     (lambda (_prompt choices &rest _) (caar choices)))
                    ((symbol-function 'yes-or-no-p) (lambda (&rest _) nil))
                    ((symbol-function 'emacs-dsh--show)
                     (lambda (&rest _) (ert-fail "cancelled session was opened"))))
