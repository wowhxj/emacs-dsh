          (with-temp-file file
            (insert (json-serialize
                     '((version . 1) (url . "http://evil.example:19387/")
                       (launch . ((encoding . "plain")
                                  (value . "http://evil.example:19387/?token=bad")))))))
          (should-error (emacs-dsh--bridge-launch)))
