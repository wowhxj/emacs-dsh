    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "tool/call") (seq . 1)
       (data . ((callId . "c1") (name . "run_code")
                (arguments . "{\"code\":\"echo hi\"}")))))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 2)
       (data . ((callId . "c2") (name . "read_file")
                (arguments . "{\"path\":\"README.md\"}")))))
    (emacs-dsh--event
     '((type . "tool/result") (seq . 3)
       (data . ((message . ((source . ((callId . "c1")))
                             (content . (((type . "text") (text . "done"))))))))))
    (let ((first (gethash "c1" emacs-dsh--tool-cards))
          (second (gethash "c2" emacs-dsh--tool-cards)))
      (should (<= (overlay-end (emacs-dsh--tool-card-details first))
                  (overlay-start (emacs-dsh--tool-card-header second))))
      (should (eq (emacs-dsh--tool-card-status first) 'success))
      (should (eq (emacs-dsh--tool-card-status second) 'running))
      (should (equal emacs-dsh--active-tools '("read_file")))
      (should (eq (overlay-get (emacs-dsh--tool-card-details first) 'invisible)
                  'emacs-dsh-tool-details))
      (should (invisible-p (overlay-start (emacs-dsh--tool-card-details first))))
      (should (string-match-p "run_code.*echo hi"
                              (overlay-get (emacs-dsh--tool-card-header first)
                                           'display)))
      (should (string-match-p "done" (buffer-string)))
      (goto-char (overlay-start (emacs-dsh--tool-card-header first)))
      (should (eq (lookup-key (overlay-get (emacs-dsh--tool-card-header first)
                                           'keymap) (kbd "RET"))
                  #'emacs-dsh-toggle-tool-details))
      (should (eq (key-binding (kbd "RET"))
                  #'emacs-dsh-toggle-tool-details))
      (emacs-dsh-toggle-tool-details)
      (should (emacs-dsh--tool-card-expanded first))
      (should-not (overlay-get (emacs-dsh--tool-card-details first) 'invisible))
      (should-not (invisible-p (overlay-start (emacs-dsh--tool-card-details first))))
      (emacs-dsh-toggle-tool-details)
      (should-not (emacs-dsh--tool-card-expanded first)))))

