(ert-deftest emacs-dsh-ui-queue-inbox-sync-freezes-during-item-edit ()
  (let ((owner (generate-new-buffer " *dsh-owner*"))
        (panel (generate-new-buffer " *dsh-panel*"))
        (editor (generate-new-buffer " *dsh-editor*")))
    (unwind-protect
        (progn
          (with-current-buffer owner
            (emacs-dsh-chat-mode)
            (setq emacs-dsh--queue-buffer panel emacs-dsh--queue-items nil))
          (with-current-buffer panel
            (emacs-dsh-queue-mode)
            (setq emacs-dsh--queue-owner owner emacs-dsh--queue-editor editor
                  emacs-dsh--queue-baseline '((queued . ((id . "a"))))))
          (with-current-buffer owner (emacs-dsh--queue-panel-sync))
          (should (equal (buffer-local-value 'emacs-dsh--queue-baseline panel)
                         '((queued . ((id . "a"))))))
          (kill-buffer editor)
          (with-current-buffer owner (emacs-dsh--queue-panel-sync))
          (should-not (buffer-local-value 'emacs-dsh--queue-baseline panel)))
      (when (buffer-live-p owner) (kill-buffer owner))
      (when (buffer-live-p panel) (kill-buffer panel))
      (when (buffer-live-p editor) (kill-buffer editor)))))
