;;; tests.el --- emacs-dsh tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-dsh)

(ert-deftest emacs-dsh-compose-and-history ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (should (emacs-dsh--input-widget))
    (emacs-dsh--replace-draft "hello")
    (should (equal (emacs-dsh--draft-text) "hello"))
    (emacs-dsh--event '((type . "turn/start") (seq . 0)))
    (emacs-dsh--event '((type . "user/message") (seq . 1)
                        (data . ((role . "user") (content . (((type . "text") (text . "hello"))))))))
    (should (equal emacs-dsh--last-prompt "hello"))
    (should (string-match-p "You: hello" (buffer-string)))
    (should (equal (emacs-dsh--draft-text) "hello"))))

(ert-deftest emacs-dsh-shortcuts-use-shared-mode-map-only ()
  (let ((global-resume (lookup-key global-map (kbd "C-c C-r")))
        (global-queue (lookup-key global-map (kbd "C-c C-l"))))
    (with-temp-buffer
      (emacs-dsh-chat-mode)
      (emacs-dsh--compose)
      (let ((input-map (widget-get (emacs-dsh--input-widget) :keymap)))
        (should (eq (keymap-parent emacs-dsh-chat-mode-map) emacs-dsh-mode-map))
        (dolist (binding '(("C-c C-r" . emacs-dsh-resume)
                           ("C-c C-l" . emacs-dsh-queue)
                           ("C-c C-c" . emacs-dsh-send)
                           ("C-c C-s" . emacs-dsh-steer)
                           ("C-c C-k" . emacs-dsh-cancel)
                           ("C-c C-q" . emacs-dsh-quit)
                           ("C-c C-p" . emacs-dsh-paste)
                           ("TAB" . emacs-dsh-complete)))
          (let ((key (kbd (car binding)))
                (command (cdr binding)))
            (should (eq (lookup-key emacs-dsh-mode-map key) command))
            (should (eq (lookup-key emacs-dsh-chat-mode-map key) command))
            (should (eq (lookup-key input-map key) command))))
      (should (eq (lookup-key emacs-dsh-chat-mode-map (kbd "i"))
                  #'emacs-dsh-focus-input))
      (should (eq (lookup-key input-map (kbd "S-<return>")) #'newline))
      (should (eq (lookup-key input-map (kbd "C-e"))
                  #'widget-end-of-line)))
    (should (equal (lookup-key global-map (kbd "C-c C-r")) global-resume))
    (should (equal (lookup-key global-map (kbd "C-c C-l")) global-queue)))))

(ert-deftest emacs-dsh-prompt-history-navigation ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (dolist (entry '((1 "first") (2 "second")))
      (emacs-dsh--event
       `((type . "user/message") (seq . ,(car entry))
         (data . ((content . (((type . "text") (text . ,(cadr entry))))))))))
    (should (equal emacs-dsh--prompt-history '("second" "first")))
    (emacs-dsh--replace-draft "unfinished\ndraft")
    (call-interactively (key-binding (kbd "M-n")))
    (should (equal (widget-value (emacs-dsh--input-widget))
                   "unfinished\ndraft"))
    (goto-char (point-min))
    (should (eq (key-binding (kbd "M-p")) #'emacs-dsh-previous-prompt))
    (call-interactively (key-binding (kbd "M-p")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "second"))
    (should (eq (key-binding (kbd "M-n")) #'emacs-dsh-next-prompt))
    (call-interactively (key-binding (kbd "M-p")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "first"))
    (call-interactively (key-binding (kbd "M-n")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "second"))
    (call-interactively (key-binding (kbd "M-n")))
    (should (equal (widget-value (emacs-dsh--input-widget))
                   "unfinished\ndraft"))
    (goto-char (emacs-dsh--draft-beginning))
    (should (eq (key-binding (kbd "M-p")) #'emacs-dsh-previous-prompt))
    (call-interactively (key-binding (kbd "M-p")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "second"))))

(ert-deftest emacs-dsh-prompt-history-ignores-runtime-and-images ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((source . ((kind . "runtime-context")))
                (content . (((type . "text") (text . "hidden"))))))))
    (emacs-dsh--event
     '((type . "user/message") (seq . 2)
       (data . ((content . (((type . "image") (data . "aGVsbG8="))))))))
    (emacs-dsh--event
     '((type . "user/message") (seq . 3)
       (data . ((content . (((type . "text") (text . "visible"))
                            ((type . "image") (data . "aGVsbG8="))))))))
    (should (equal emacs-dsh--prompt-history '("visible")))))

(ert-deftest emacs-dsh-composer-accepts-typing-and-protects-history ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--insert-before-input "DSH session s1")
    (emacs-dsh--compose)
    (let ((last-command-event ?h))
      (call-interactively #'self-insert-command))
    (should (equal (emacs-dsh--draft-text) "h"))
    (emacs-dsh-select-draft)
    (should (equal (buffer-substring-no-properties
                    (region-beginning) (region-end)) "h"))
    (emacs-dsh--replace-draft "")
    (should (eq (key-binding (kbd "h")) #'self-insert-command))
    (let ((last-command-event ?h))
      (call-interactively #'self-insert-command))
    (should (equal (emacs-dsh--draft-text) "h"))
    (goto-char (point-min))
    (should-error (insert "overwrite"))))

(ert-deftest emacs-dsh-i-focuses-composer-without-changing-draft ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--insert-before-input "History")
    (emacs-dsh--compose)
    (emacs-dsh--replace-draft "hello")
    (goto-char (point-min))
    (should (eq (key-binding (kbd "i")) #'emacs-dsh-focus-input))
    (call-interactively (key-binding (kbd "i")))
    (should (= (point) (+ (emacs-dsh--draft-beginning) 5)))
    (should (equal (emacs-dsh--draft-text) "hello"))
    (should (eq (key-binding (kbd "i")) #'self-insert-command))
    (let ((last-command-event ?i))
      (call-interactively (key-binding (kbd "i"))))
    (should (equal (emacs-dsh--draft-text) "helloi"))))

(ert-deftest emacs-dsh-composer-multiline-has-no-padding ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (should (eq (lookup-key emacs-dsh--input-keymap (kbd "S-<return>"))
                #'newline))
    (emacs-dsh--replace-draft "hello")
    (should (equal (buffer-substring-no-properties
                    (emacs-dsh--draft-beginning) (point-max)) "hello\n"))
    (should (eq (plist-get (overlay-get emacs-dsh--input-background 'face)
                           :extend) t))
    (goto-char (emacs-dsh--draft-beginning))
    (call-interactively (key-binding (kbd "S-<return>")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "\nhello"))))

(ert-deftest emacs-dsh-return-submits-composer ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (insert "hello")
    (should (eq (key-binding (kbd "RET")) #'emacs-dsh-send))
    (let (sent)
      (cl-letf (((symbol-function 'emacs-dsh--call)
                 (lambda (_endpoint args success &optional _on-error)
                   (setq sent args)
                   (funcall success '((accepted . t))))))
        (call-interactively (key-binding (kbd "RET"))))
      (should (equal (alist-get 'text
                               (aref (alist-get 'content (alist-get 'request sent)) 0))
                     "hello"))
      (should (equal (emacs-dsh--draft-text) ""))
      (should (eq (key-binding (kbd "RET")) #'emacs-dsh-send)))))

(ert-deftest emacs-dsh-wire-shapes ()
  (let* ((payload '((request . ((requestId . "r1")
                                 (sessionId . "s1") (mode . "queue")
                                 (content . [((type . "text") (text . "hi"))])))))
         (decoded (json-parse-string (json-serialize payload)
                                     :object-type 'alist :array-type 'array))
         (content (alist-get 'content (alist-get 'request decoded))))
    (should (equal (alist-get 'text (aref content 0)) "hi"))))

(ert-deftest emacs-dsh-stream-and-replay ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (emacs-dsh--stream '((type . "start") (attemptId . "a1")))
    (emacs-dsh--stream '((type . "chunk") (attemptId . "a1")
                         (chunk . ((type . "text-delta") (text . "hello")))))
    (should (string-match-p "hello" (overlay-get emacs-dsh--stream-overlay 'before-string)))
    (let ((event `((type . "assistant/message") (seq . 2)
                   (data . ((message . ((content . ,(list '((type . "text") (text . "hello")))))))))))
      (emacs-dsh--event event)
      (should-not (overlay-get emacs-dsh--stream-overlay 'before-string))
      (emacs-dsh--event event)
      (should (= 1 (cl-count-if (lambda (line) (string-prefix-p "DSH: hello" line))
                                (split-string (buffer-string) "\n")))))))

(ert-deftest emacs-dsh-direct-final-reply-needs-no-process-fold ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((content . (((type . "text") (text . "hi"))))))))
    (emacs-dsh--event '((type . "turn/start") (seq . 2)))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 3)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "hello"))))))))))
    (emacs-dsh--event '((type . "turn/end") (seq . 4)))
    (should-not (string-match-p "▸ Process" (buffer-string)))))

(ert-deftest emacs-dsh-process-fold-keeps-last-assistant-message ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event '((type . "turn/start") (seq . 2)))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 3)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "intermediate"))))))))))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 4)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "final"))))))))))
    (emacs-dsh--event '((type . "turn/end") (seq . 5)))
    (goto-char (point-min))
    (search-forward "▸ Process")
    (let ((body (cl-loop for ov in (overlays-at (1- (point)))
                         thereis (overlay-get ov 'emacs-dsh-process))))
      (should body)
      (should (string-match-p "DSH: intermediate"
                              (buffer-substring-no-properties
                               (overlay-start body) (overlay-end body))))
      (should-not (string-match-p "DSH: final"
                                  (buffer-substring-no-properties
                                   (overlay-start body) (overlay-end body)))))))

(ert-deftest emacs-dsh-final-reply-folds-intermediate-process ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event '((type . "turn/start") (seq . 2)))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 3)
       (data . ((callId . "c1") (name . "run_code")
                (arguments . "lots of process")))))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 4)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "final answer"))))))))))
    (should (string-match-p "DSH: final answer" (buffer-string)))
    (should-not (string-match-p "▸ Process" (buffer-string)))
    (emacs-dsh--event '((type . "turn/end") (seq . 5)))
    (should (string-match-p "You: question" (buffer-string)))
    (should (string-match-p "DSH: final answer" (buffer-string)))
    (goto-char (point-min))
    (search-forward "▸ Process")
    (let* ((header (cl-find-if (lambda (ov) (overlay-get ov 'emacs-dsh-process))
                               (overlays-at (1- (point)))))
           (body (overlay-get header 'emacs-dsh-process)))
      (should header)
      (should (eq (overlay-get body 'invisible) 'emacs-dsh-process))
      (should (string-match-p "lots of process"
                              (buffer-substring-no-properties
                               (overlay-start body) (overlay-end body))))
      (should (<= (overlay-end body)
                  (save-excursion (goto-char (point-min))
                                  (search-forward "DSH: final answer"))))
      (goto-char (overlay-start header))
      (emacs-dsh-toggle-process)
      (should-not (overlay-get body 'invisible))
      (emacs-dsh-toggle-process)
      (should (eq (overlay-get body 'invisible) 'emacs-dsh-process)))))

(ert-deftest emacs-dsh-host-order-turn-folds-steps-but-not-prompt ()
  "Host order: turn/start precedes the prompt; tool calls also arrive as blocks."
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event '((type . "turn/start") (seq . 1) (time . 1000)))
    (emacs-dsh--event
     '((type . "user/message") (seq . 2) (time . 1001)
       (data . ((source . ((kind . "user")))
                (content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 3) (time . 2000)
       (data . ((message . ((content . ,(list '((type . "reasoning")
                                              (text . "**Inspecting repo**\n\ndetail"))
                                            '((type . "tool-call") (id . "c1")
                                              (name . "run_code")
                                              (arguments . "{\"code\":\"ls\"}"))))))))))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 4) (time . 2001)
       (data . ((callId . "c1") (name . "run_code") (arguments . "{\"code\":\"ls\"}")))))
    (emacs-dsh--event
     '((type . "tool/result") (seq . 5) (time . 3000)
       (data . ((message . ((callId . "c1") (content . (((type . "text") (text . "ok"))))))))))
    (should-not (string-match-p "\\[tool:" (buffer-string)))
    (let* ((header (cl-loop for ov in (overlays-in (point-min) (point-max))
                            for card = (overlay-get ov 'emacs-dsh-tool-card)
                            when (and card (equal (emacs-dsh--tool-card-name card) "Thinking"))
                            return ov))
           (card (overlay-get header 'emacs-dsh-tool-card)))
      (should (string-match-p "Thinking — Inspecting repo" (overlay-get header 'display)))
      (should (eq (lookup-key (overlay-get header 'keymap) (kbd "TAB"))
                  #'emacs-dsh-toggle-tool-details))
      (goto-char (overlay-start header))
      (emacs-dsh-toggle-tool-details)
      (should (emacs-dsh--tool-card-expanded card)))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 6) (time . 4000)
       (data . ((message . ((content . ,(list '((type . "text") (text . "answer"))))))))))
    (emacs-dsh--event '((type . "turn/end") (seq . 7) (time . 518000)))
    (goto-char (point-min))
    (search-forward "▸ Process · 8m 37s · 2 steps")
    (let* ((header (cl-find-if (lambda (ov) (overlay-get ov 'emacs-dsh-process))
                               (overlays-at (1- (point)))))
           (body (overlay-get header 'emacs-dsh-process))
           (hidden (buffer-substring-no-properties (overlay-start body)
                                                   (overlay-end body))))
      (should (eq (lookup-key (overlay-get header 'keymap) (kbd "TAB"))
                  #'emacs-dsh-toggle-process))
      (should-not (string-match-p "You: question" hidden))
      (should-not (string-match-p "DSH: answer" hidden))
      (should (< (save-excursion (goto-char (point-min)) (search-forward "You: question"))
                 (overlay-start header)))
      (goto-char (overlay-start header))
      (emacs-dsh-toggle-process)
      (should (string-prefix-p "▾ Process · 8m 37s" (overlay-get header 'display))))))

(ert-deftest emacs-dsh-failed-turn-still-folds-steps ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event '((type . "turn/start") (seq . 1) (time . 0)))
    (emacs-dsh--event
     '((type . "user/message") (seq . 2)
       (data . ((content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 3)
       (data . ((callId . "c1") (name . "run_code") (arguments . "hidden step")))))
    (emacs-dsh--event
     '((type . "turn/end") (seq . 4) (time . 5000)
       (data . ((reason . ((kind . "error") (error . ((message . "boom")))))))))
    (goto-char (point-min))
    (search-forward "▸ Process · 5s · 1 step")
    (let ((body (cl-loop for ov in (overlays-at (1- (point)))
                         thereis (overlay-get ov 'emacs-dsh-process))))
      (should (string-match-p "hidden step" (buffer-substring-no-properties
                                             (overlay-start body) (overlay-end body))))
      (should (< (overlay-end body)
                 (save-excursion (search-forward "[turn error: boom]")))))))

(ert-deftest emacs-dsh-follow-shape-and-history-order ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (let* ((frame (json-parse-string (emacs-dsh--follow-payload)
                                     :object-type 'alist))
           (request (alist-get 'request (alist-get 'args (alist-get 'payload frame)))))
      (should (equal (alist-get 'sessionId (alist-get 'address request)) "s1")))
    (emacs-dsh--event '((type . "turn/start") (seq . 0)))
    (emacs-dsh--event '((type . "user/message") (seq . 1)
                        (data . ((role . "user") (source . ((kind . "user")))
                                 (content . (((type . "text") (text . "first"))))))))
    (emacs-dsh--event '((type . "user/message") (seq . 2)
                        (data . ((role . "user") (source . ((kind . "runtime-context")))
                                 (content . (((type . "text") (text . "hidden"))))))))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 3)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "second"))))))))))
    (let ((rendered (buffer-string)))
      (should (string-match-p "You: first\\(?:.\\|\n\\)*DSH: second" rendered))
      (should-not (string-match-p "hidden" rendered))
      (should (equal emacs-dsh--last-prompt "first")))))

(ert-deftest emacs-dsh-tool-result-and-turn-error ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (let ((block '((type . "tool-result") (isError . t)
                   (content . (((type . "text") (text . "command failed")))))))
      (emacs-dsh--event
       `((type . "tool/result") (seq . 1)
          (data . ((message . ((content . (,block))))
                   (error . ((reason . "Permission denied"))))))))
    (emacs-dsh--event
     '((type . "turn/end") (seq . 2)
       (data . ((reason . ((kind . "error")
                           (error . ((message . "runtime stopped")))))))))
    (should (string-match-p "Error:\\s-*\n    command failed" (buffer-string)))
    (should (string-match-p "Reason: Permission denied" (buffer-string)))
    (should (string-match-p "\\[turn error: runtime stopped\\]" (buffer-string)))))

(ert-deftest emacs-dsh-markdown-message-keeps-source-and-styles-heading ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "assistant/message") (seq . 1)
       (data . ((message . ((content . (((type . "text")
                                         (text . "# Title\n\n**important** and `code`\n[Docs](https://example.org/docs)\n\n```python\nprint(1)\n```"))))))))))
    (let ((source (buffer-string)))
      (should (string-match-p "DSH: # Title" source))
      (should (string-match-p "\\*\\*important\\*\\*" source))
      (should (string-match-p "```python" source))
      (goto-char (point-min))
      (search-forward "# Title")
      (should (or (get-text-property (- (point) 7) 'display)
                  (get-text-property (- (point) 7) 'invisible)))
      (should (or (get-text-property (- (point) 5) 'face)
                  (get-text-property (- (point) 5) 'font-lock-face)))
      (search-forward "Docs")
      (backward-char 2)
      (should (eq (key-binding (kbd "RET")) #'emacs-dsh-open-link))
      (let (opened)
        (cl-letf (((symbol-function 'browse-url)
                   (lambda (url &rest _) (setq opened url))))
          (emacs-dsh-open-link))
        (should (equal opened "https://example.org/docs")))
      (search-forward "print(1)")
      (should (or (get-text-property (- (point) 4) 'face)
                  (get-text-property (- (point) 4) 'font-lock-face))))))

(ert-deftest emacs-dsh-tool-card-folds-and-matches-result-by-call-id ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "tool/call") (seq . 1)
       (data . ((callId . "c1") (name . "run_code")
                (arguments . "{\"code\":\"echo hi\"}")))))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 2)
       (data . ((callId . "c2") (name . "read_file")
                (arguments . "{\"path\":\"README.md\"}")))))
    (emacs-dsh--event
     '((type . "tool/result") (seq . 3)
       (data . ((message . ((source . ((callId . "c1")))
                             (content . (((type . "text") (text . "done"))))))))))
    (let ((first (gethash "c1" emacs-dsh--tool-cards))
          (second (gethash "c2" emacs-dsh--tool-cards)))
      (should (<= (overlay-end (emacs-dsh--tool-card-details first))
                  (overlay-start (emacs-dsh--tool-card-header second))))
      (should (eq (emacs-dsh--tool-card-status first) 'success))
