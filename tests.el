(ert-deftest emacs-dsh-concurrent-auth-keeps-origin-buffers ()
  (let ((first (generate-new-buffer " *emacs-dsh-auth-first*"))
        (second (generate-new-buffer " *emacs-dsh-auth-second*"))
        (emacs-dsh-connection-mode 'desktop)
        (emacs-dsh--auth-running nil)
        (emacs-dsh--auth-waiters nil)
        (emacs-dsh--cookie-jar nil)
        (emacs-dsh--authenticated-base nil)
        (emacs-dsh--authenticated-nonce nil)
        (emacs-dsh--authenticated-mode nil)
        exchange replies)
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-dsh--bridge-launch)
                   (lambda () '("http://127.0.0.1:19387/" "launch" "nonce")))
                  ((symbol-function 'emacs-dsh--exchange-token)
                   (lambda (_launch callback) (setq exchange callback))))
          (with-current-buffer first
            (emacs-dsh--ensure-auth
             (lambda (_failure) (push (current-buffer) replies))))
          (with-current-buffer second
            (emacs-dsh--ensure-auth
             (lambda (_failure) (push (current-buffer) replies))))
          (with-temp-buffer (funcall exchange "dsh-auth-test=ok" nil))
          (should (equal (nreverse replies) (list first second))))
      (kill-buffer first)
      (kill-buffer second))))

(ert-deftest emacs-dsh-managed-launch-parser-is-local-and-bounded ()
  (should (equal (emacs-dsh--managed-parse-launch
                  "ready\ndsh web: http://127.0.0.1:48123/?token=abc_DEF-1\n")
                 '("http://127.0.0.1:48123/"
                   "http://127.0.0.1:48123/?token=abc_DEF-1")))
  (should-not (emacs-dsh--managed-parse-launch
               "dsh web: http://192.168.1.1:48123/?token=secret"))
  (should-not (emacs-dsh--managed-parse-launch
               "dsh web: http://127.0.0.1:99999/?token=secret")))

(ert-deftest emacs-dsh-managed-start-shares-one-process ()
  (let ((emacs-dsh--managed-process nil)
        (emacs-dsh--managed-connection nil)
        (emacs-dsh--managed-output "")
        (emacs-dsh--managed-waiters nil)
        (emacs-dsh--managed-timer nil)
        (emacs-dsh-managed-command "dsh")
        (launches 0)
        replies command)
    (cl-letf (((symbol-function 'executable-find) (lambda (_name) "/usr/bin/dsh"))
              ((symbol-function 'process-live-p) (lambda (_process) t))
              ((symbol-function 'make-process)
               (lambda (&rest args)
                 (setq command (plist-get args :command))
                 (cl-incf launches)
                 'fake-process))
              ((symbol-function 'run-at-time) (lambda (&rest _args) 'fake-timer))
              ((symbol-function 'cancel-timer) (lambda (_timer) nil)))
      (emacs-dsh--managed-start (lambda (connection failure)
                                  (push (list connection failure) replies)))
      (emacs-dsh--managed-start (lambda (connection failure)
                                  (push (list connection failure) replies)))
      (should (= launches 1))
      (should (equal command '("/usr/bin/dsh" "web" "--host" "127.0.0.1"
                               "--port" "0" "--no-open")))
      (emacs-dsh--managed-filter 'fake-process
                                  "dsh web: http://127.0.0.1:48123/?tok")
      (should-not replies)
      (emacs-dsh--managed-filter 'fake-process "en=abc\n")
      (should (= (length replies) 2))
      (should (equal (car (car (car replies))) "http://127.0.0.1:48123/"))
      (should (equal (cadr (car (car replies)))
                     "http://127.0.0.1:48123/?token=abc"))
      (should-not (cadr (car replies)))
      (should (equal emacs-dsh--managed-output "")))))

(ert-deftest emacs-dsh-managed-auth-reuses-and-invalidates-cookie ()
  (let ((emacs-dsh-connection-mode 'managed)
        (emacs-dsh--auth-running nil)
        (emacs-dsh--auth-waiters nil)
        (emacs-dsh--cookie-jar nil)
        (emacs-dsh--authenticated-base nil)
        (emacs-dsh--authenticated-nonce nil)
        (emacs-dsh--authenticated-mode nil)
        (emacs-dsh--managed-connection
         '("http://127.0.0.1:48123/" "http://127.0.0.1:48123/?token=abc" "first"))
        (exchanges 0)
        replies)
    (cl-letf (((symbol-function 'emacs-dsh--managed-start)
               (lambda (callback)
                 (funcall callback emacs-dsh--managed-connection nil)))
              ((symbol-function 'emacs-dsh--exchange-token)
               (lambda (_launch callback)
                 (cl-incf exchanges)
                 (funcall callback (format "dsh-auth-test=%d" exchanges) nil))))
      (emacs-dsh--ensure-auth (lambda (failure) (push failure replies)))
      (emacs-dsh--ensure-auth (lambda (failure) (push failure replies)))
      (should (= exchanges 1))
      (setq emacs-dsh--managed-connection
            '("http://127.0.0.1:48124/" "http://127.0.0.1:48124/?token=def" "second"))
      (emacs-dsh--ensure-auth (lambda (failure) (push failure replies)))
      (should (= exchanges 2))
      (should (equal emacs-dsh--authenticated-base "http://127.0.0.1:48124/"))
      (should (equal emacs-dsh--cookie-jar "dsh-auth-test=2"))
      (should (equal replies '(nil nil nil))))))

(ert-deftest emacs-dsh-managed-missing-cli-reports-error-without-hanging ()
  (let ((emacs-dsh-connection-mode 'managed)
        (emacs-dsh-managed-command "missing-dsh-test")
        (emacs-dsh--managed-process nil)
        (emacs-dsh--managed-connection nil)
        (emacs-dsh--managed-waiters nil)
        (emacs-dsh--auth-running nil)
        (emacs-dsh--auth-waiters nil)
        failure)
    (cl-letf (((symbol-function 'executable-find) (lambda (_name) nil))
              ((symbol-function 'file-executable-p) (lambda (_name) nil)))
      (emacs-dsh--ensure-auth (lambda (error) (setq failure error)))
      (should (string-match-p "Cannot find dsh executable" failure))
      (should-not emacs-dsh--auth-running)
      (should-not emacs-dsh--managed-waiters))))

(ert-deftest emacs-dsh-auto-prefers-bridge-then-falls-back-to-managed ()
  (let ((file (make-temp-file "emacs-dsh-auto-"))
        (emacs-dsh-connection-mode 'auto)
        (emacs-dsh--auth-running nil)
        (emacs-dsh--auth-waiters nil)
        (emacs-dsh--cookie-jar nil)
        (emacs-dsh--authenticated-base nil)
        (emacs-dsh--authenticated-nonce nil)
        (emacs-dsh--authenticated-mode nil)
        (emacs-dsh--managed-connection nil)
        launches replies)
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-dsh--bridge-path)
                   (lambda () file))
                  ((symbol-function 'emacs-dsh--bridge-launch)
                   (lambda ()
                     (push 'desktop launches)
                     '("http://127.0.0.1:48123/"
                       "http://127.0.0.1:48123/?token=desktop" "desktop")))
                  ((symbol-function 'emacs-dsh--managed-start)
                   (lambda (callback)
                     (push 'managed launches)
                     (setq emacs-dsh--managed-connection
                           '("http://127.0.0.1:48124/"
                             "http://127.0.0.1:48124/?token=managed" "managed"))
                     (funcall callback emacs-dsh--managed-connection nil)))
                  ((symbol-function 'emacs-dsh--exchange-token)
                   (lambda (_launch callback)
                     (funcall callback "dsh-auth-test=ok" nil))))
          (should (eq (emacs-dsh--effective-mode) 'desktop))
          (emacs-dsh--ensure-auth (lambda (failure) (push failure replies)))
          (should (equal launches '(desktop)))
          (should (eq emacs-dsh--authenticated-mode 'desktop))
          (delete-file file)
          (should (eq (emacs-dsh--effective-mode) 'managed))
          (emacs-dsh--ensure-auth (lambda (failure) (push failure replies)))
          (should (equal launches '(managed desktop)))
          (should (eq emacs-dsh--authenticated-mode 'managed))
          (should (equal replies '(nil nil))))
      (when (file-exists-p file) (delete-file file)))))

(ert-deftest emacs-dsh-explicit-mode-overrides-auto-detection ()
