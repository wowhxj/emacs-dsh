(ert-deftest emacs-dsh-whitespace-assistant-messages-do-not-create-rows ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event '((type . "turn/start") (seq . 0)))
    (dotimes (index 3)
      (emacs-dsh--event
       `((type . "assistant/message") (seq . ,(1+ (* index 3)))
         (data . ((message . ((content . [((type . "text") (text . "\n\n \t\n\n"))])))))))
      (emacs-dsh--event
       `((type . "tool/call") (seq . ,(+ 2 (* index 3)))
         (data . ((id . ,(format "call-%d" index)) (name . "glob") (arguments . "{}")))))
      (emacs-dsh--event
       `((type . "tool/result") (seq . ,(+ 3 (* index 3)))
         (data . ((id . ,(format "call-%d" index)) (content . [((type . "text") (text . "done"))]))))))
    (should-not (string-match-p "DSH:" (buffer-string)))
    (should-not emacs-dsh--last-answer)
    (let ((answer "\n\nAnswer\n\n    code\n\n\n"))
      (emacs-dsh--event
       `((type . "assistant/message") (seq . 10)
         (data . ((message . ((content . [((type . "text") (text . ,answer))])))))))
      (should (equal emacs-dsh--last-answer answer)))
    (emacs-dsh--event '((type . "turn/end") (seq . 11) (data . ((reason . ((kind . "completed")))))))
    (let ((header (cl-find-if (lambda (overlay)
                                (overlay-get overlay 'emacs-dsh-process-label))
                              (overlays-in (point-min) (point-max)))) visible)
      (goto-char (overlay-start header))
      (emacs-dsh-toggle-process)
      (setq visible (apply #'string
                           (cl-loop for pos from (point-min) below (point-max)
                                    unless (invisible-p pos) collect (char-after pos))))
      ;; Check the Process rows, not the intentional separator before You>.
      (should-not (string-match-p "\n[ \t]*\n[ \t]*\n"
                                  (substring visible 0 (string-match "DSH: Answer" visible))))
      (should (= (cl-count ?D visible) 1))
      (should (string-match-p "Answer\n\n    code" (buffer-string))))))

