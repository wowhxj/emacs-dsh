;;; tests.el --- emacs-dsh tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-dsh)
(defvar orderless-smart-case)

(ert-deftest emacs-dsh-compose-and-history ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (should (emacs-dsh--input-widget))
    (emacs-dsh--replace-draft "hello")
    (should (equal (emacs-dsh--draft-text) "hello"))
    (emacs-dsh--event '((type . "turn/start") (seq . 0)))
    (emacs-dsh--event '((type . "user/message") (seq . 1)
                        (data . ((role . "user") (content . (((type . "text") (text . "hello"))))))))
    (should (equal emacs-dsh--last-prompt "hello"))
    (should (string-match-p "You: hello" (buffer-string)))
    (should (equal (emacs-dsh--draft-text) "hello"))))

(ert-deftest emacs-dsh-shortcuts-use-shared-mode-map-only ()
  (let ((global-resume (lookup-key global-map (kbd "C-c C-r")))
        (global-queue (lookup-key global-map (kbd "C-c C-l")))
        (global-queue-u (lookup-key global-map (kbd "C-c C-u"))))
    (with-temp-buffer
      (emacs-dsh-chat-mode)
      (emacs-dsh--compose)
      (let ((input-map (widget-get (emacs-dsh--input-widget) :keymap)))
        (should (eq (keymap-parent emacs-dsh-chat-mode-map) emacs-dsh-mode-map))
        (dolist (binding '(("C-c C-r" . emacs-dsh-resume)
                           ("C-c C-l" . emacs-dsh-queue)
                           ("C-c C-u" . emacs-dsh-queue)
                           ("C-c C-c" . emacs-dsh-send)
                           ("C-c C-s" . emacs-dsh-steer)
                           ("C-c C-k" . emacs-dsh-cancel)
                           ("C-c C-q" . emacs-dsh-quit)
                           ("C-c C-p" . emacs-dsh-paste)
                           ("TAB" . emacs-dsh-complete)))
          (let ((key (kbd (car binding)))
                (command (cdr binding)))
            (should (eq (lookup-key emacs-dsh-mode-map key) command))
            (should (eq (lookup-key emacs-dsh-chat-mode-map key) command))
            (should (eq (lookup-key input-map key) command))))
      (should (eq (lookup-key emacs-dsh-chat-mode-map (kbd "i"))
                  #'emacs-dsh-focus-input))
      (should (eq (lookup-key input-map (kbd "S-<return>")) #'newline))
      (should (eq (lookup-key input-map (kbd "C-e"))
                  #'widget-end-of-line)))
    (should (equal (lookup-key global-map (kbd "C-c C-r")) global-resume))
    (should (equal (lookup-key global-map (kbd "C-c C-l")) global-queue))
    (should (equal (lookup-key global-map (kbd "C-c C-u")) global-queue-u)))))

(ert-deftest emacs-dsh-prompt-history-navigation ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (dolist (entry '((1 "first") (2 "second")))
      (emacs-dsh--event
       `((type . "user/message") (seq . ,(car entry))
         (data . ((content . (((type . "text") (text . ,(cadr entry))))))))))
    (should (equal emacs-dsh--prompt-history '("second" "first")))
    (emacs-dsh--replace-draft "unfinished\ndraft")
    (call-interactively (key-binding (kbd "M-n")))
    (should (equal (widget-value (emacs-dsh--input-widget))
                   "unfinished\ndraft"))
    (goto-char (point-min))
    (should (eq (key-binding (kbd "M-p")) #'emacs-dsh-previous-prompt))
    (call-interactively (key-binding (kbd "M-p")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "second"))
    (should (eq (key-binding (kbd "M-n")) #'emacs-dsh-next-prompt))
    (call-interactively (key-binding (kbd "M-p")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "first"))
    (call-interactively (key-binding (kbd "M-n")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "second"))
    (call-interactively (key-binding (kbd "M-n")))
    (should (equal (widget-value (emacs-dsh--input-widget))
                   "unfinished\ndraft"))
    (goto-char (emacs-dsh--draft-beginning))
    (should (eq (key-binding (kbd "M-p")) #'emacs-dsh-previous-prompt))
    (call-interactively (key-binding (kbd "M-p")))
    (should (equal (widget-value (emacs-dsh--input-widget)) "second"))))

