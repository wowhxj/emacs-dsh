                     '("http://127.0.0.1:48123/"
                       "http://127.0.0.1:48123/?token=desktop" "desktop")))
                  ((symbol-function 'emacs-dsh--managed-start)
                   (lambda (callback)
                     (push 'managed launches)
                     (setq emacs-dsh--managed-connection
                           '("http://127.0.0.1:48124/"
                             "http://127.0.0.1:48124/?token=managed" "managed"))
                     (funcall callback emacs-dsh--managed-connection nil)))
                  ((symbol-function 'emacs-dsh--exchange-token)
                   (lambda (_launch callback)
                     (funcall callback "dsh-auth-test=ok" nil))))
          (should (eq (emacs-dsh--effective-mode) 'desktop))
          (emacs-dsh--ensure-auth (lambda (failure) (push failure replies)))
          (should (equal launches '(desktop)))
          (should (eq emacs-dsh--authenticated-mode 'desktop))
          (delete-file file)
          (should (eq (emacs-dsh--effective-mode) 'managed))
          (emacs-dsh--ensure-auth (lambda (failure) (push failure replies)))
          (should (equal launches '(managed desktop)))
          (should (eq emacs-dsh--authenticated-mode 'managed))
          (should (equal replies '(nil nil))))
      (when (file-exists-p file) (delete-file file)))))

