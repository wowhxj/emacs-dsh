(ert-deftest emacs-dsh-session-reference-requests-one-metadata-list ()
  "Validate both session/list envelopes through the real call wrapper."
  (with-temp-buffer
    (let ((items '(((sessionId . "one")
                    (projections
                     (values (turnOutline . (((prompt . "first")) ((prompt . "latest"))))
                             (sessionListMetadata (lastPromptAt . 1792486800000)))))))
          calls shown)
      (cl-letf (((symbol-function 'emacs-dsh--ensure-auth)
                 (lambda (callback) (funcall callback nil)))
                ((symbol-function 'emacs-dsh--request)
                 (lambda (endpoint args callback)
                   (push endpoint calls)
                   (if (equal endpoint "session/list")
                       (progn
                         (should (equal (mapcar #'car args) '(_request)))
                         (should (hash-table-p (alist-get '_request args)))
                         (should (= (hash-table-count (alist-get '_request args)) 0))
                         (funcall callback (list (cons 'items items)) nil))
                     (should (equal (alist-get 'query args) "query"))
                     (funcall callback
                              '(((sessionId . "one") (mention . "host mention"))) nil))))
                ((symbol-function 'emacs-dsh--show-reference-choices)
                 (lambda (_context _files sessions) (setq shown sessions))))
        (emacs-dsh--complete-session-reference '(:query "query"))
        (should (equal (reverse calls) '("sessionReferenceResolver/candidates" "session/list")))
        (should (equal (alist-get 'firstUserQuery (car shown)) "first"))
        (should (equal (alist-get 'lastUserQuery (car shown)) "latest"))
        (should (= (float-time (alist-get 'lastUserTime (car shown))) 1792486800))
        (should (equal (alist-get 'mention (car shown)) "host mention"))))))

