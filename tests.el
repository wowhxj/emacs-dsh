(ert-deftest emacs-dsh-return-submits-composer ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (insert "hello")
    (should (eq (key-binding (kbd "RET")) #'emacs-dsh-send))
    (let (sent)
      (cl-letf (((symbol-function 'emacs-dsh--call)
                 (lambda (_endpoint args success &optional _on-error)
                   (setq sent args)
                   (funcall success '((accepted . t))))))
        (call-interactively (key-binding (kbd "RET"))))
      (should (equal (alist-get 'text
                               (aref (alist-get 'content (alist-get 'request sent)) 0))
                     "hello"))
      (should (equal (emacs-dsh--draft-text) ""))
      (should (eq (key-binding (kbd "RET")) #'emacs-dsh-send)))))

(ert-deftest emacs-dsh-wire-shapes ()
  (let* ((payload '((request . ((requestId . "r1")
                                 (sessionId . "s1") (mode . "queue")
                                 (content . [((type . "text") (text . "hi"))])))))
         (decoded (json-parse-string (json-serialize payload)
                                     :object-type 'alist :array-type 'array))
         (content (alist-get 'content (alist-get 'request decoded))))
    (should (equal (alist-get 'text (aref content 0)) "hi"))))

(ert-deftest emacs-dsh-stream-and-replay ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (emacs-dsh--stream '((type . "start") (attemptId . "a1")))
    (emacs-dsh--stream '((type . "chunk") (attemptId . "a1")
                         (chunk . ((type . "text-delta") (text . "hello")))))
    (should (string-match-p "hello" (overlay-get emacs-dsh--stream-overlay 'before-string)))
    (let ((event `((type . "assistant/message") (seq . 2)
                   (data . ((message . ((content . ,(list '((type . "text") (text . "hello")))))))))))
      (emacs-dsh--event event)
      (should-not (overlay-get emacs-dsh--stream-overlay 'before-string))
      (emacs-dsh--event event)
      (should (= 1 (cl-count-if (lambda (line) (string-prefix-p "DSH: hello" line))
                                (split-string (buffer-string) "\n")))))))

(ert-deftest emacs-dsh-stream-stays-after-the-latest-prompt-across-turns ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--replace-draft "unsent draft")
    (dotimes (round 3)
      (let ((seq (* round 4))
            (attempt (format "attempt-%d" round))
            (prompt (format "prompt-%d" round))
            (answer (format "answer-%d" round)))
        (emacs-dsh--event `((type . "turn/start") (seq . ,(1+ seq))))
        (emacs-dsh--event
         `((type . "user/message") (seq . ,(+ seq 2))
           (data . ((content . [((type . "text") (text . ,prompt))])))))
        (let ((history (buffer-string)) (position (point)))
          (emacs-dsh--stream `((type . "start") (attemptId . ,attempt)))
          (emacs-dsh--stream
           `((type . "chunk") (attemptId . ,attempt)
             (chunk . ((type . "text-delta") (text . ,answer)))))
          (should (= (overlay-start emacs-dsh--stream-overlay)
                     (marker-position emacs-dsh--input-start)))
          (should (= (overlay-end emacs-dsh--stream-overlay)
                     (marker-position emacs-dsh--input-start)))
          (should (> (overlay-start emacs-dsh--stream-overlay)
                     (save-excursion
                       (goto-char (point-max))
                       (search-backward (concat "You: " prompt)))))
          (should (equal (buffer-string) history))
          (should (= (point) position))
          (should (equal (emacs-dsh--draft-text) "unsent draft")))
        (emacs-dsh--event
         `((type . "assistant/message") (seq . ,(+ seq 3))
           (data . ((message . ((content . [((type . "text") (text . ,answer))])))))))
        (should-not (overlay-get emacs-dsh--stream-overlay 'before-string))
        (emacs-dsh--stream `((type . "end") (attemptId . ,attempt)))
        (emacs-dsh--event
         `((type . "turn/end") (seq . ,(+ seq 4))
           (data . ((reason . ((kind . "completed")))))))
        (should (= 1 (cl-count (concat "DSH: " answer)
                              (split-string (buffer-string) "\n") :test #'equal)))))))

(ert-deftest emacs-dsh-stream-follows-delayed-prompt-and-tool-inserts ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    ;; The text stream and canonical event log are delivered independently.
    (emacs-dsh--stream '((type . "start") (attemptId . "a1")))
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((content . [((type . "text") (text . "new prompt"))])))))
    (should (= (overlay-start emacs-dsh--stream-overlay)
               (marker-position emacs-dsh--input-start)))
    (emacs-dsh--stream
     '((type . "chunk") (attemptId . "a1")
       (chunk . ((type . "text-delta") (text . "partial reply")))))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 2)
       (data . ((toolCallId . "call1") (toolName . "Read") (args . "{}")))))
    (should (= (overlay-start emacs-dsh--stream-overlay)
               (marker-position emacs-dsh--input-start)))
    (should (string-match-p "partial reply"
                            (overlay-get emacs-dsh--stream-overlay 'before-string)))))

(ert-deftest emacs-dsh-stream-reanchors-existing-stale-overlay ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    ;; Simulate a persistent overlay left by an older loaded definition.
    (setq emacs-dsh--stream-overlay (make-overlay (point-min) (point-min)))
    (emacs-dsh--insert-before-input "You: latest prompt")
    (emacs-dsh--stream '((type . "start") (attemptId . "a1")))
    (emacs-dsh--stream
     '((type . "chunk") (attemptId . "a1")
       (chunk . ((type . "text-delta") (text . "latest reply")))))
    (should (= (overlay-start emacs-dsh--stream-overlay)
               (marker-position emacs-dsh--input-start)))
    (should (string-match-p "latest reply"
                            (overlay-get emacs-dsh--stream-overlay 'before-string)))))

(ert-deftest emacs-dsh-stream-remains-before-staged-image-previews ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (emacs-dsh--insert-before-input "You: running query")
    (emacs-dsh--replace-draft "next query")
    (emacs-dsh--stream '((type . "start") (attemptId . "a1")))
    (emacs-dsh--stream
     '((type . "chunk") (attemptId . "a1")
       (chunk . ((type . "text-delta") (text . "partial reply")))))
    (emacs-dsh--stage-image "image/png" "next.png" "aGVsbG8=")
    (should (= (overlay-start emacs-dsh--stream-overlay)
               (overlay-start emacs-dsh--attachment-overlay)))
    (should (equal (emacs-dsh--draft-text) "next query"))
    (setq emacs-dsh--attachments nil)
    (emacs-dsh--update-image-preview)
    (should (= (overlay-start emacs-dsh--stream-overlay)
               (marker-position emacs-dsh--input-start)))
    (should (equal (emacs-dsh--draft-text) "next query"))))

(ert-deftest emacs-dsh-direct-final-reply-needs-no-process-fold ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((content . (((type . "text") (text . "hi"))))))))
    (emacs-dsh--event '((type . "turn/start") (seq . 2)))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 3)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "hello"))))))))))
    (emacs-dsh--event '((type . "turn/end") (seq . 4)
                        (data . ((reason . ((kind . "completed")))))))
    (should-not (string-match-p "▸ Process" (buffer-string)))
    (should-not (string-match-p "\\[turn" (buffer-string)))
    (should-not (string-match-p "─" (buffer-string)))))

(ert-deftest emacs-dsh-process-fold-keeps-last-assistant-message ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event '((type . "turn/start") (seq . 2)))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 3)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "intermediate"))))))))))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 4)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "final"))))))))))
    (emacs-dsh--event '((type . "turn/end") (seq . 5)))
    (goto-char (point-min))
    (search-forward "▸ Process")
    (let ((body (cl-loop for ov in (overlays-at (1- (point)))
                         thereis (overlay-get ov 'emacs-dsh-process))))
      (should body)
      (should (string-match-p "DSH: intermediate"
                              (buffer-substring-no-properties
                               (overlay-start body) (overlay-end body))))
      (should-not (string-match-p "DSH: final"
                                  (buffer-substring-no-properties
                                   (overlay-start body) (overlay-end body)))))))

(ert-deftest emacs-dsh-final-reply-folds-intermediate-process ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event
     '((type . "user/message") (seq . 1)
       (data . ((content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event '((type . "turn/start") (seq . 2)))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 3)
       (data . ((callId . "c1") (name . "run_code")
                (arguments . "lots of process")))))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 4)
       (data . ((message . ((content . ,(list '((type . "text")
                                              (text . "final answer"))))))))))
    (should (string-match-p "DSH: final answer" (buffer-string)))
    (should-not (string-match-p "▸ Process" (buffer-string)))
    (emacs-dsh--event '((type . "turn/end") (seq . 5)))
    (should (string-match-p "You: question" (buffer-string)))
    (should (string-match-p "DSH: final answer" (buffer-string)))
    (goto-char (point-min))
    (search-forward "▸ Process")
    (let* ((header (cl-find-if (lambda (ov) (overlay-get ov 'emacs-dsh-process))
                               (overlays-at (1- (point)))))
           (body (overlay-get header 'emacs-dsh-process)))
      (should header)
      (should (eq (overlay-get body 'invisible) 'emacs-dsh-process))
      (should (string-match-p "lots of process"
                              (buffer-substring-no-properties
                               (overlay-start body) (overlay-end body))))
      (should (<= (overlay-end body)
                  (save-excursion (goto-char (point-min))
                                  (search-forward "DSH: final answer"))))
      (goto-char (overlay-start header))
      (emacs-dsh-toggle-process)
      (should-not (overlay-get body 'invisible))
      (emacs-dsh-toggle-process)
      (should (eq (overlay-get body 'invisible) 'emacs-dsh-process)))))

(ert-deftest emacs-dsh-host-order-turn-folds-steps-but-not-prompt ()
  "Host order: turn/start precedes the prompt; tool calls also arrive as blocks."
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event '((type . "turn/start") (seq . 1) (time . 1000)))
    (emacs-dsh--event
     '((type . "user/message") (seq . 2) (time . 1001)
       (data . ((source . ((kind . "user")))
                (content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 3) (time . 2000)
       (data . ((message . ((content . ,(list '((type . "reasoning")
                                              (text . "**Inspecting repo**\n\ndetail"))
                                            '((type . "tool-call") (id . "c1")
                                              (name . "run_code")
                                              (arguments . "{\"code\":\"ls\"}"))))))))))
    (emacs-dsh--event
     '((type . "tool/call") (seq . 4) (time . 2001)
       (data . ((callId . "c1") (name . "run_code") (arguments . "{\"code\":\"ls\"}")))))
    (emacs-dsh--event
     '((type . "tool/result") (seq . 5) (time . 3000)
       (data . ((message . ((callId . "c1") (content . (((type . "text") (text . "ok"))))))))))
    (should-not (string-match-p "\\[tool:" (buffer-string)))
    (let* ((header (cl-loop for ov in (overlays-in (point-min) (point-max))
                            for card = (overlay-get ov 'emacs-dsh-tool-card)
                            when (and card (equal (emacs-dsh--tool-card-name card) "Thinking"))
                            return ov))
           (card (overlay-get header 'emacs-dsh-tool-card)))
      (should (string-match-p "Thinking — Inspecting repo" (overlay-get header 'display)))
      (should (eq (lookup-key (overlay-get header 'keymap) (kbd "TAB"))
                  #'emacs-dsh-toggle-tool-details))
      (goto-char (overlay-start header))
      (emacs-dsh-toggle-tool-details)
      (should (emacs-dsh--tool-card-expanded card)))
    (emacs-dsh--event
     `((type . "assistant/message") (seq . 6) (time . 4000)
       (data . ((message . ((content . ,(list '((type . "text") (text . "answer"))))))))))
    (emacs-dsh--event '((type . "turn/end") (seq . 7) (time . 518000)))
    (goto-char (point-min))
    (search-forward "▸ Process · 8m 37s · 2 steps")
    (let* ((header (cl-find-if (lambda (ov) (overlay-get ov 'emacs-dsh-process))
                               (overlays-at (1- (point)))))
           (body (overlay-get header 'emacs-dsh-process))
           (hidden (buffer-substring-no-properties (overlay-start body)
                                                   (overlay-end body))))
      (should (eq (lookup-key (overlay-get header 'keymap) (kbd "TAB"))
                  #'emacs-dsh-toggle-process))
      (should-not (string-match-p "You: question" hidden))
      (should-not (string-match-p "DSH: answer" hidden))
      ;; Redisplay draws `display' before honouring `invisible'; the hidden
      ;; run must not start on a step header or swallow the reply's newline.
      (should (eq (char-after (overlay-start body)) ?\n))
      (should-not (cl-some (lambda (ov) (overlay-get ov 'display))
                           (overlays-at (overlay-start body))))
      (should (string-suffix-p "\n" (overlay-get header 'display)))
      (should (< (save-excursion (goto-char (point-min)) (search-forward "You: question"))
                 (overlay-start header)))
      (goto-char (overlay-start header))
      (emacs-dsh-toggle-process)
      (should (string-prefix-p "▾ Process · 8m 37s" (overlay-get header 'display))))))

(ert-deftest emacs-dsh-failed-turn-still-folds-steps ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (emacs-dsh--compose)
    (emacs-dsh--event '((type . "turn/start") (seq . 1) (time . 0)))
    (emacs-dsh--event
     '((type . "user/message") (seq . 2)
       (data . ((content . (((type . "text") (text . "question"))))))))
    (emacs-dsh--event
