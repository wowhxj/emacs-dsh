(ert-deftest emacs-dsh-session-reference-aligns-user-queries-on-narrow-windows ()
  (let* ((emacs-dsh--session-id "current")
         (stamp (seconds-to-time 1792486800))
         (sessions `(((sessionId . "first-session") (cwd . "/short")
                      (firstUserQuery . "第一句话\n请看这个 query")
                      (lastUserQuery . "最后一句话\t请提交修改")
                      (lastUserTime . ,stamp) (mention . "@[First](dsh-session:one)"))
                     ((sessionId . "other-session") (cwd . "/a/much/longer/project")
                      (firstUserQuery . ,(make-string 100 ?中)) (lastUserQuery . "Done")
                      (mention . "@[Other](dsh-session:two)")))))
    (dolist (width '(64 80 120 180 240))
      (let* ((choices (emacs-dsh--session-reference-choices sessions width))
             (columns (mapcar (lambda (choice) (split-string (car choice) " │ ")) choices))
             (header (get-text-property 0 'emacs-dsh-session-header (caar choices))))
        (should (equal (mapcar #'string-width (car columns))
                       (mapcar #'string-width (cadr columns))))
        (should (equal (mapcar #'string-width (car columns))
                       (mapcar #'string-width (split-string header " │ "))))
        (should (<= (string-width (caar choices)) width))
        (should (= (length (car columns)) (if (>= width 120) 5 4)))
        (should (string-prefix-p (format-time-string "%Y-%m-%d %H:%M" stamp) (caar choices)))
        (should-not (string-match-p "[\n\r\t]" (caar choices)))
        (should (string-match-p "第一" (caar choices)))
        (should (string-match-p "最后" (caar choices)))
        (should-not (string-match-p "[Uu]ntitled\\|\\[session\\]" (caar choices)))
        (should (equal (cdar choices) "@[First](dsh-session:one)"))))))

(ert-deftest emacs-dsh-session-reference-sorts-user-time-and-distinguishes-ids ()
