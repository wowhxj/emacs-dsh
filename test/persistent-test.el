;;; persistent-test.el --- Managed Host lifecycle contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-dsh)

(ert-deftest emacs-dsh-persistent-quit-only-closes-chat ()
  (let ((buffer (generate-new-buffer " *dsh-persistent-quit*"))
        (emacs-dsh--chats (make-hash-table :test #'equal))
        (emacs-dsh--events-socket nil)
        (emacs-dsh--events-retry nil))
    (unwind-protect
        (with-current-buffer buffer
          (emacs-dsh-chat-mode)
          (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "fixture-session")
          (should (eq (lookup-key emacs-dsh-chat-mode-map (kbd "C-c C-q")) #'emacs-dsh-quit))
          (cl-letf (((symbol-function 'emacs-dsh--call)
                     (lambda (&rest _args) (ert-fail "Quit must not mutate Host/session")))
                    ((symbol-function 'emacs-dsh--managed-stop)
                     (lambda () (ert-fail "Chat quit must not stop/detach shared Host helper")))
                    ((symbol-function 'emacs-dsh-runtime-shutdown)
                     (lambda (&rest _args) (ert-fail "Chat quit must not stop Host"))))
            (emacs-dsh-quit))
          (should-not (buffer-live-p buffer)))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest emacs-dsh-persistent-metadata-discovers-existing-host-without-startup ()
  (let ((emacs-dsh-connection-mode 'managed)
        (emacs-dsh-managed-persistent t)
        (emacs-dsh--managed-process nil)
        (emacs-dsh--managed-connection nil)
        (emacs-dsh--managed-source-key nil)
        (emacs-dsh--cookie-jar nil)
        (emacs-dsh--auth-running nil)
        (emacs-dsh--authenticated-base nil)
        (emacs-dsh--authenticated-nonce nil)
        (emacs-dsh--authenticated-mode nil)
        (done nil) failure)
    (cl-letf (((symbol-function 'emacs-dsh-runtime-existing-connection)
               (lambda () '("http://127.0.0.1:23456/" "private-launch" "stable-generation")))
              ((symbol-function 'emacs-dsh-runtime-key) (lambda () "selected-profile"))
              ((symbol-function 'emacs-dsh--exchange-token)
               (lambda (_launch callback) (funcall callback "dsh-auth-test=value" nil)))
              ((symbol-function 'emacs-dsh--managed-start)
               (lambda (&rest _args) (ert-fail "Read-only discovery started a Host"))))
      (emacs-dsh--metadata-auth (lambda (error) (setq failure error done t))))
    (should done) (should-not failure)
    (should (equal emacs-dsh--authenticated-nonce "stable-generation"))
    (should-not emacs-dsh--managed-process)))

(ert-deftest emacs-dsh-persistent-rejects-source-change-before-spawning ()
  (let ((emacs-dsh-managed-persistent t)
        (emacs-dsh--managed-source-key "old-profile") failure)
    (cl-letf (((symbol-function 'emacs-dsh-runtime-key) (lambda () "new-profile"))
              ((symbol-function 'make-process)
               (lambda (&rest _args) (ert-fail "Source switch must not launch a Host"))))
      (emacs-dsh--managed-start (lambda (_connection error) (setq failure error))))
    (should (string-match-p "configuration changed" failure))))

(ert-deftest emacs-dsh-persistent-inspection-rejects-nonlocal-launch ()
  (cl-letf (((symbol-function 'emacs-dsh-runtime-inspect)
             (lambda () '((status . "running") (base . "http://192.168.1.5:80/")
                           (launch . "http://192.168.1.5:80/?token=unsafe")
                           (generation . "fixture")))))
    (should-error (emacs-dsh-runtime-existing-connection))))

(ert-deftest emacs-dsh-persistent-shutdown-never-targets-desktop ()
  (let ((emacs-dsh-connection-mode 'desktop))
    (cl-letf (((symbol-function 'emacs-dsh-runtime-shutdown)
               (lambda (&rest _args) (ert-fail "Desktop must not be stopped")))
              ((symbol-function 'yes-or-no-p)
               (lambda (&rest _args) (ert-fail "Must reject before prompting"))))
      (should-error (emacs-dsh-shutdown-managed-host) :type 'user-error))))

(ert-deftest emacs-dsh-persistent-directory-verification-accepts-only-real-local-aliases ()
  (let* ((root (make-temp-file "/tmp/dsh-dir-" t))
         (project (expand-file-name "project" root))
         (other (expand-file-name "other" root))
         (alias (expand-file-name "alias" root)))
    (unwind-protect
        (progn
          (make-directory project)
          (make-directory other)
          (make-symbolic-link project alias)
          (should (emacs-dsh--same-host-directory-p alias (file-truename project)))
          (should-not (emacs-dsh--same-host-directory-p alias other))
          (should-not (emacs-dsh--same-host-directory-p alias "/missing-dsh-dir-fixture"))
          (should-not (emacs-dsh--same-host-directory-p "C:\\work" "D:\\work")))
      (delete-directory root t))))

(provide 'persistent-test)
;;; persistent-test.el ends here
