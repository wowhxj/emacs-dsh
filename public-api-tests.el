;;; public-api-tests.el --- Public integration seams -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-dsh)

(ert-deftest emacs-dsh-api-list-does-not-start-managed-host ()
  (let ((emacs-dsh-connection-mode 'managed)
        emacs-dsh--managed-process emacs-dsh--managed-connection failure)
    (cl-letf (((symbol-function 'emacs-dsh--managed-start)
               (lambda (&rest _) (ert-fail "Metadata started Host")))
              ((symbol-function 'emacs-dsh--request)
               (lambda (&rest _) (ert-fail "Unavailable Host was queried"))))
      (emacs-dsh-list-sessions
       (lambda (_) (ert-fail "Unavailable Host succeeded"))
       :on-error (lambda (err) (setq failure err)))
      (should (stringp failure)))))

(ert-deftest emacs-dsh-api-list-uses-only-metadata-endpoint ()
  (let ((emacs-dsh--authenticated-base "http://localhost:1/") result calls)
    (cl-letf (((symbol-function 'emacs-dsh--metadata-auth) (lambda (cb) (funcall cb nil)))
              ((symbol-function 'emacs-dsh--request)
               (lambda (endpoint _args callback)
                 (push endpoint calls)
                 (funcall callback '((items . (((sessionId . "s"))))) nil))))
      (emacs-dsh-list-sessions (lambda (value) (setq result value)))
      (should (equal calls '("session/list")))
      (should (equal (alist-get 'sessionId (car (plist-get result :items))) "s")))))

(ert-deftest emacs-dsh-api-open-verifies-snapshot-and-keeps-layout ()
  (save-window-excursion
    (delete-other-windows)
    (split-window-right)
    (let* ((emacs-dsh--chats (make-hash-table :test #'equal))
           (root (file-name-as-directory temporary-file-directory))
           (original (window-buffer))
           (buffer (generate-new-buffer " *dsh-api-test*"))
           ready failure)
      (unwind-protect
          (cl-letf (((symbol-function 'emacs-dsh--ensure-auth) (lambda (cb) (funcall cb nil)))
                    ((symbol-function 'websocket-openp) (lambda (_) t))
                    ((symbol-function 'emacs-dsh--show)
                     (lambda (id directory display)
                       (should (equal id "s"))
                       (should (eq display 'none))
                       (with-current-buffer buffer
                         (setq-local emacs-dsh--socket 'fake
                                     emacs-dsh--verified-session (list id directory)))
                       buffer)))
            (emacs-dsh-open-session "s" :directory root :display 'none
                                    :on-ready (lambda (b) (setq ready b))
                                    :on-error (lambda (e) (setq failure e)))
            (let ((deadline (+ (float-time) 1)))
              (while (and (not ready) (not failure) (< (float-time) deadline))
                (accept-process-output nil 0.02)))
            (should-not failure)
            (should (eq ready buffer))
            (should (= (length (window-list)) 2))
            (should (eq original (window-buffer))))
        (kill-buffer buffer)))))

(ert-deftest emacs-dsh-api-list-transport-error-terminates-once ()
  (let ((count 0))
    (cl-letf (((symbol-function 'emacs-dsh--metadata-auth) (lambda (cb) (funcall cb nil)))
              ((symbol-function 'emacs-dsh--request) (lambda (&rest _) (error "Synthetic failure"))))
      (emacs-dsh-list-sessions
       (lambda (_) (ert-fail "Transport error succeeded"))
       :on-error (lambda (_) (cl-incf count)))
      (should (= count 1)))))

(ert-deftest emacs-dsh-api-list-cancel-suppresses-late-response ()
  (let (reply result)
    (cl-letf (((symbol-function 'emacs-dsh--metadata-auth) (lambda (cb) (funcall cb nil)))
              ((symbol-function 'emacs-dsh--request)
               (lambda (_endpoint _args cb) (setq reply cb))))
      (funcall (emacs-dsh-list-sessions (lambda (value) (setq result value))))
      (funcall reply '((items . nil)) nil)
      (should-not result))))

(ert-deftest emacs-dsh-api-create-uses-normal-setup-without-picker-or-prompt ()
  (let ((root (make-temp-file "dsh-create-api-" t)) (buffer (generate-new-buffer " *dsh-created*"))
        (original (window-buffer)) endpoints ready failure)
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-dsh--ensure-auth) (lambda (callback) (funcall callback nil)))
                  ((symbol-function 'emacs-dsh--source-identity) (lambda () '("host" "nonce" desktop)))
                  ((symbol-function 'completing-read) (lambda (&rest _) (ert-fail "Unexpected picker")))
                  ((symbol-function 'emacs-dsh--show) (lambda (&rest _) (ert-fail "Creation bypassed public open")))
                  ((symbol-function 'emacs-dsh--call)
                   (lambda (endpoint args success &optional _on-error)
                     (should (equal emacs-dsh--source '("host" "nonce" desktop)))
                     (push endpoint endpoints)
                     (pcase endpoint
                       ("workspace/create" (funcall success '((workspace . ((workspaceId . "w"))))))
                       ("session/create"
                        (should (equal (alist-get 'agentPreset (alist-get 'request args)) "standard"))
                        (funcall success '((sessionId . "fresh"))))
                       ("permissionPresets/catalog" (funcall success '((options . (((value . "auto")))))))
                       ("commands/execute"
                        (should (string-prefix-p "/permission " (alist-get 'line args)))
                        (funcall success '((result . ((kind . "success"))))))
                       (_ (ert-fail endpoint)))))
                  ((symbol-function 'emacs-dsh-open-session)
                   (lambda (id &rest args)
                     (should (equal id "fresh"))
                     (should (equal (plist-get args :directory) (file-name-as-directory (file-truename root))))
                     (should (eq (plist-get args :display) 'none))
                     (funcall (plist-get args :on-ready) buffer)
                     #'ignore)))
          (emacs-dsh-create-session root :display 'none
                                    :on-ready (lambda (value) (setq ready value))
                                    :on-error (lambda (error) (setq failure error)))
          (should-not failure) (should (eq ready buffer))
          (should (eq original (window-buffer)))
          (should (equal (reverse endpoints) '("workspace/create" "session/create" "permissionPresets/catalog" "commands/execute"))))
      (kill-buffer buffer) (delete-directory root))))

(ert-deftest emacs-dsh-api-create-cancel-and-host-change-do-not-open ()
  (dolist (action '(cancel host-change))
    (let ((root (make-temp-file "dsh-create-boundary-" t))
          (identity '("host" "nonce" desktop)) complete failure)
      (unwind-protect
          (cl-letf (((symbol-function 'emacs-dsh--ensure-auth) (lambda (callback) (funcall callback nil)))
                    ((symbol-function 'emacs-dsh--source-identity) (lambda () identity))
                    ((symbol-function 'emacs-dsh--create-session)
                     (lambda (_root _preset callback &optional _failure) (setq complete callback)))
                    ((symbol-function 'emacs-dsh-open-session) (lambda (&rest _) (ert-fail "Opened cancelled/wrong Host session"))))
            (let ((cancel (emacs-dsh-create-session root :on-error (lambda (error) (setq failure error)))))
              (if (eq action 'cancel) (funcall cancel) (setq identity '("other" "nonce" desktop)))
              (funcall complete "fresh" root)
              (if (eq action 'cancel) (should-not failure) (should (string-match-p "Host changed" failure)))))
        (delete-directory root)))))

(defconst emacs-dsh-api-test-snapshot
  (json-serialize
   '((type . "snapshot")
     (header . ((sessionId . "s") (cwd . "/work")))
     (projections . ((values . ((title . "T")))))
     (records
      . [((event . ((seq . 1) (type . "user/message") (time . 10)
                    (data . ((message . ((content . [((type . "text") (text . "hi"))]))))))))
         ((event . ((seq . 2) (type . "user/message")
                    (data . ((message . ((source . ((kind . "agent")))
                                         (content . [((type . "text") (text . "injected"))]))))))))
         ((event . ((seq . 3) (type . "tool/call") (data . ((name . "bash"))))))
         ((event . ((seq . 4) (type . "assistant/message") (time . 11)
                    (data . ((message . ((content . [((type . "reasoning") (text . "think"))
                                                     ((type . "tool-call") (name . "bash"))
                                                     ((type . "text") (text . "\nhello\n"))]))))))))
         ((event . ((seq . 5) (type . "assistant/message")
                    (data . ((message . ((content . [((type . "text") (text . "  "))]))))))))])))
  "A follow snapshot frame value, as JSON text from the Host.")

(defun emacs-dsh-api-test-parse (json)
  "Parse Host JSON like the client's frame handlers."
  (json-parse-string json :object-type 'alist :array-type 'list
                     :null-object nil :false-object nil))

(ert-deftest emacs-dsh-api-snapshot-dialogue-keeps-only-user-and-assistant-text ()
  (should (equal (emacs-dsh--snapshot-dialogue (emacs-dsh-api-test-parse emacs-dsh-api-test-snapshot))
                 '((:role user :text "hi" :time 10)
                   (:role assistant :text "hello" :time 11)))))

(ert-deftest emacs-dsh-api-read-does-not-start-managed-host ()
  (let ((emacs-dsh-connection-mode 'managed)
        emacs-dsh--managed-process emacs-dsh--managed-connection failure)
    (cl-letf (((symbol-function 'emacs-dsh--managed-start)
               (lambda (&rest _) (ert-fail "Session read started Host")))
              ((symbol-function 'websocket-open)
               (lambda (&rest _) (ert-fail "Unavailable Host was queried"))))
      (emacs-dsh-read-session "s" (lambda (_) (ert-fail "Unavailable Host succeeded"))
                              :on-error (lambda (err) (setq failure err)))
      (should (stringp failure)))))

(defun emacs-dsh-api-test-read (snapshot)
  "Run `emacs-dsh-read-session' against fake SNAPSHOT; return (RESULT FAILURE SENT CLOSED)."
  (let (result failure sent closed)
    (cl-letf (((symbol-function 'emacs-dsh--metadata-auth) (lambda (cb) (funcall cb nil)))
              ((symbol-function 'emacs-dsh--base) (lambda () "http://localhost:1/"))
              ((symbol-function 'emacs-dsh--source-identity) (lambda () 'host))
              ((symbol-function 'websocket-send-text) (lambda (_ws text) (push text sent)))
              ((symbol-function 'websocket-close) (lambda (_ws) (setq closed t)))
              ((symbol-function 'websocket-open)
               (lambda (url &rest args)
                 (should (equal url "ws://localhost:1/api/remote.mux"))
                 (funcall (plist-get args :on-open) 'ws)
                 (funcall (plist-get args :on-message) 'ws
                          (make-websocket-frame
                           :opcode 'text
                           :payload (format "{\"streamId\":\"s\",\"type\":\"item\",\"value\":%s}"
                                            snapshot)))
                 'ws)))
      (emacs-dsh-read-session "s" (lambda (value) (setq result value))
                              :on-error (lambda (err) (setq failure err))
                              :max-messages 7))
    (list result failure sent closed)))

(ert-deftest emacs-dsh-api-read-returns-verified-snapshot-dialogue ()
  (pcase-let ((`(,result ,failure ,sent ,closed)
               (emacs-dsh-api-test-read emacs-dsh-api-test-snapshot)))
    (should-not failure)
    (should closed)
    (should (string-match-p "\"maxMessages\":7" (car sent)))
    (should (equal (plist-get result :session-id) "s"))
    (should (equal (plist-get result :cwd) "/work"))
    (should (equal (plist-get result :title) "T"))
    (should (eq (plist-get result :source) 'host))
    (should (= (plist-get result :max-messages) 7))
    (should (= (length (plist-get result :messages)) 2))))

(ert-deftest emacs-dsh-api-read-rejects-unverified-session ()
  (pcase-let ((`(,result ,failure ,_sent ,closed)
               (emacs-dsh-api-test-read "{\"type\":\"snapshot\",\"header\":{\"cwd\":\"/w\"}}")))
    (should-not result)
    (should closed)
    (should (string-match-p "verified" failure))))

(ert-deftest emacs-dsh-api-reference-provider-replaces-at-name ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (let ((emacs-dsh-reference-providers
           (list (cons "ashub" (lambda (root)
                                 (should (equal root "/tmp/"))
                                 "/cache/ref one.md")))))
      (emacs-dsh--replace-draft "see @ashub")
      (emacs-dsh-focus-input)
      (should (eq (plist-get (emacs-dsh--completion-context) :kind) 'provider))
      (cl-letf (((symbol-function 'emacs-dsh--call)
                 (lambda (&rest _) (ert-fail "Provider reference queried the Host"))))
        (emacs-dsh-complete))
      (should (equal (emacs-dsh--draft-text) "see @\"/cache/ref one.md\"")))
    (emacs-dsh--replace-draft "see @ashub")
    (emacs-dsh-focus-input)
    (should (eq (plist-get (emacs-dsh--completion-context) :kind) 'file))))

(ert-deftest emacs-dsh-api-insert-file-accepts-path ()
  (with-temp-buffer
    (emacs-dsh-chat-mode)
    (setq-local emacs-dsh--root "/tmp/" emacs-dsh--session-id "s1")
    (emacs-dsh--compose)
    (emacs-dsh--replace-draft "see")
    (emacs-dsh-insert-file "/tmp/x.md")
    (should (equal (emacs-dsh--draft-text) "see @x.md"))))

