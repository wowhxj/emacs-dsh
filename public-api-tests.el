(ert-deftest emacs-dsh-api-passive-activity-requires-explicit-idle-and-types ()
  (let* ((cold '((reason . "idle") (state . ((cursor . 4) (active . :json-false)
                                            (running . :json-false) (queue . :json-null) (pendingInput . [])))))
         (warm '((reason . "idle") (state . ((cursor . 4) (active . t)
                                            (running . :json-false) (queue . []) (pendingInput . []))))))
    (should (eq (plist-get (emacs-dsh--passive-activity cold) :activity) 'idle))
    (should (eq (plist-get (emacs-dsh--passive-activity warm) :activity) 'idle))
    (let ((context '((reason . "idle") (state . ((cursor . 4) (active . t) (running . :json-false)
                                                (queue . [((placement . "context") (content . "private-context"))]) (pendingInput . []))))))
      (should (eq (plist-get (emacs-dsh--passive-activity context) :activity) 'idle))
      (should (= (plist-get (emacs-dsh--passive-activity context) :context-count) 1))
      (should (= (plist-get (emacs-dsh--passive-activity context) :queue-count) 0)))
    (dolist (value '(((reason . "timeout") (state . ((cursor . 4) (active . t) (running . :json-false) (queue . []) (pendingInput . []))))
                     ((reason . "idle") (state . ((cursor . 4) (active . t) (running . t) (queue . []) (pendingInput . []))))
                     ((reason . "idle") (state . ((cursor . 4) (active . t) (running . :json-false) (queue . [((placement . "queued") (content . "private-queued"))]) (pendingInput . []))))
                     ((reason . "input-required") (state . ((cursor . 4) (active . t) (running . :json-false) (queue . []) (pendingInput . ["approval"]))))))
      (let ((projection (emacs-dsh--passive-activity value)))
        (should-not (eq (plist-get projection :activity) 'idle))
        (should-not (string-match-p "private-queued" (prin1-to-string projection)))))
    (dolist (value '(((reason . "idle") (state . ((cursor . 4) (active) (running) (queue) (pendingInput))))
                     ((reason . "idle") (state . ((cursor . 4) (active . :json-false) (running . :json-false) (queue . :json-null))))
                     ((reason . "idle") (state . ((cursor . 4) (active . t) (running . :json-false) (queue . :json-null) (pendingInput . []))))))
      (should-error (emacs-dsh--passive-activity value)))))

(ert-deftest emacs-dsh-api-typed-rpc-preserves-false-null-and-empty-array ()
  (let ((emacs-dsh--source nil) result failure)
    (cl-letf (((symbol-function 'emacs-dsh--base) (lambda () "http://127.0.0.1:1/"))
              ((symbol-function 'emacs-dsh--url-retrieve)
               (lambda (_url cb)
                 (let* ((rpc-id (alist-get 'rpcId (json-parse-string url-request-data :object-type 'alist)))
                        (buffer (generate-new-buffer " *typed-rpc-fixture*")))
                   (with-current-buffer buffer
                     (insert "HTTP/1.1 200 OK\r\n\r\n{\"type\":\"server-response\",\"rpcId\":\"" rpc-id
                             "\",\"result\":{\"ok\":true,\"value\":{\"false\":false,\"null\":null,\"empty\":[]}}}")
                     (funcall cb nil)) buffer))))
      (emacs-dsh--request "session/wait" nil (lambda (value error) (setq result value failure error)) t)
      (should-not failure)
      (should (eq (alist-get 'false result) :json-false))
      (should (eq (alist-get 'null result) :json-null))
      (should (equal (alist-get 'empty result) [])))))

(ert-deftest emacs-dsh-api-passive-activity-is-source-pinned-and-output-suppressed ()
  (let ((emacs-dsh--authenticated-base "base") (emacs-dsh--authenticated-nonce "generation")
        (emacs-dsh--authenticated-mode 'managed) reply result failure)
    (cl-letf (((symbol-function 'emacs-dsh--metadata-auth) (lambda (cb) (funcall cb nil)))
              ((symbol-function 'emacs-dsh--request)
               (lambda (method args cb &optional typed)
                 (should typed) (should (equal method "session/wait"))
                 (should (equal (alist-get 'sessionId (alist-get 'request args)) "exact-id"))
                 (should (= (alist-get 'afterSeq (alist-get 'request args)) 9007199254740991))
                 (should (= (alist-get 'timeoutMs (alist-get 'request args)) 250))
                 (setq reply cb) nil)))
      (emacs-dsh-inspect-session-activity "exact-id" (lambda (value) (setq result value))
                                         :on-error (lambda (value) (setq failure value)))
      (funcall reply '((reason . "idle") (state . ((cursor . 4) (active . :json-false)
                                                 (running . :json-false) (queue . :json-null) (pendingInput . [])))) nil)
      (should-not failure) (should (eq (plist-get result :activity) 'idle))
      (should (equal (plist-get result :source) '("base" "generation" managed)))
      (setq result nil)
      (emacs-dsh-inspect-session-activity "exact-id" (lambda (value) (setq result value))
                                         :on-error (lambda (value) (setq failure value)))
      (setq emacs-dsh--authenticated-nonce "changed")
      (funcall reply '((reason . "idle") (state . ((cursor . 4) (active . :json-false)
                                                 (running . :json-false) (queue . :json-null) (pendingInput . [])))) nil)
      (should-not result) (should failure))))

(ert-deftest emacs-dsh-api-passive-activity-cancel-is-silent-and-does-not-cancel-agent ()
  (let (reply called)
    (cl-letf (((symbol-function 'emacs-dsh--metadata-auth) (lambda (cb) (funcall cb nil)))
