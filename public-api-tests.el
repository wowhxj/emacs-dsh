;;; public-api-tests.el --- Public integration seams -*- lexical-binding: t; -*-
(require 'ert)
(require 'emacs-dsh)

(ert-deftest emacs-dsh-api-runtime-capabilities-are-configured-not-activity ()
  (dolist (mode '(desktop managed))
    (let ((emacs-dsh-connection-mode mode) (emacs-dsh-managed-persistent t))
      (cl-letf (((symbol-function 'emacs-dsh--managed-start) (lambda (&rest _) (ert-fail "Started Host")))
                ((symbol-function 'emacs-dsh--bridge-launch) (lambda () (ert-fail "Authenticated Host"))))
        (let ((value (emacs-dsh-runtime-capabilities)))
          (should (eq (plist-get value :quit) 'detach))
          (should-not (plist-get value :finish-session))
          (should (eq (plist-get value :activity) 'unknown))
          (should (eq (not (null (plist-get value :shutdown-host))) (eq mode 'managed))))))))

(ert-deftest emacs-dsh-api-inspect-host-sanitizes-listed-runtime-presence ()
  (let ((emacs-dsh-connection-mode 'managed) result)
    (cl-letf (((symbol-function 'emacs-dsh-list-sessions)
               (lambda (success &rest _)
                 (funcall success '(:source ("http://127.0.0.1:1/" "generation" managed)
                                    :items (((sessionId . "a") (running . t) (firstUserMessage . "private-body"))
                                            ((sessionId . "b") (running)) ((sessionId . "c"))))) #'ignore)))
      (emacs-dsh-inspect-host (lambda (value) (setq result value)))
      (should (equal (mapcar (lambda (row) (plist-get row :backend-state)) (plist-get result :sessions))
                     '(present not-running unknown)))
      (should (eq (plist-get result :activity) 'unknown))
      (should (eq (plist-get result :coverage) 'listed-only))
      (should-not (string-match-p "private-body" (prin1-to-string result))))))

(ert-deftest emacs-dsh-api-inspect-host-cancel-is-silent-and-errors-are-redacted ()
  (let ((emacs-dsh-connection-mode 'desktop) reply failure cancelled result)
    (cl-letf (((symbol-function 'emacs-dsh-list-sessions)
               (lambda (success &rest args)
                 (setq reply success failure (plist-get args :on-error))
                 (lambda () (setq cancelled t)))))
      (let ((cancel (emacs-dsh-inspect-host (lambda (value) (setq result value))
                                           :on-error (lambda (value) (setq result value)))))
        (funcall cancel)
        (should cancelled)
        (funcall reply '(:source ("base" "generation" desktop) :items nil))
        (funcall failure "token=secret")
        (should-not result))
      (emacs-dsh-inspect-host #'ignore :on-error (lambda (value) (setq result value)))
      (funcall failure "token=secret")
      (should (stringp result))
      (should-not (string-match-p "secret" result)))))

(ert-deftest emacs-dsh-api-inspect-host-malformed-late-result-is-unknown ()
  (let ((emacs-dsh-connection-mode 'managed) reply failure)
    (cl-letf (((symbol-function 'emacs-dsh-list-sessions)
               (lambda (success &rest _) (setq reply success) #'ignore)))
      (emacs-dsh-inspect-host (lambda (_) (ert-fail "Malformed runtime result succeeded"))
                              :on-error (lambda (value) (setq failure value)))
      (funcall reply '(:source ("base" "generation" managed) :items ("private-invalid-body")))
      (should (stringp failure))
      (should-not (string-match-p "private-invalid-body" failure)))))

(ert-deftest emacs-dsh-api-inspect-host-rejects-source-mode-change ()
  (let ((emacs-dsh-connection-mode 'managed) reply failure)
